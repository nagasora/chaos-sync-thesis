{
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/%DOCFILE%",
  "latex-workshop.latex.tools": [
    {
      "name": "workspace-build",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "%WORKSPACE_FOLDER%/scripts/build.ps1",
        "-Source",
        "%DOC_EXT%",
        "-OutputDirectory",
        "%OUTDIR%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Workspace LuaLaTeX build",
      "tools": [
        "workspace-build"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.clean.enabled": true,
  "latex-workshop.latex.clean.method": "command",
  "latex-workshop.latex.clean.command": "powershell.exe",
  "latex-workshop.latex.clean.args": [
    "-NoProfile",
    "-ExecutionPolicy",
    "Bypass",
    "-File",
    "%WORKSPACE_FOLDER%/scripts/build.ps1",
    "-Source",
    "%DOC_EXT%",
    "-OutputDirectory",
    "%OUTDIR%",
    "-Clean"
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.view.pdf.ref.viewer": "auto",
  "files.encoding": "utf8"
}
